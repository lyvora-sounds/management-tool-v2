// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id      String  @id @default(cuid())
  clerkId String  @unique
  email   String  @unique
  name    String?
  boards        Board[]
  comments      Comment[]
  boardMembers  BoardMember[]
  assignedTasks Task[]        @relation("TaskAssignee")
  qaTasks       Task[]        @relation("TaskQA")
  taskCollaborators TaskCollaborator[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  completedTasks  Task[]        @relation("CompletedTasks")
  settings        UserSettings?
  calendarSync    UserCalendarSync?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSettings {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiProvider    String  @default("openai") // "openai" | "claude" | "gemini" | "grok" | "deepseek" | "kimi" | "custom"
  aiApiKey      String? // AES-256-GCM encrypted
  aiModel       String?
  aiBaseUrl     String?
  voiceLanguage String  @default("es-ES") // "es-ES" | "en-US"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserCalendarSync {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String    // encrypted
  refreshToken String?   // encrypted
  expiryDate   DateTime?
  calendarId   String?
  enabled      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id      String  @id @default(cuid())
  type    String  // "assigned" | "comment"
  message String
  read    Boolean @default(false)

  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  boardId String?
  taskId  String?

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId])
}

model Board {
  id          String  @id @default(cuid())
  title       String
  description String?
  color       String?
  links       Json?

  memberCanAssign Boolean @default(false)

  // Webhooks & Integrations
  slackWebhookUrl       String?
  discordWebhookUrl     String?
  notifyOnTaskCreated   Boolean @default(true)
  notifyOnTaskCompleted Boolean @default(true)
  notifyOnTaskMoved     Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  list         List[]
  labels       Label[]
  epics        Epic[]
  members      BoardMember[]
  invitations  Invitation[]
  activityLogs ActivityLog[]
  customFields CustomField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model BoardMember {
  id   String @id @default(cuid())
  role String @default("member")

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([boardId, userId])
  @@index([boardId])
}

model Invitation {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique @default(cuid())
  status    String   @default("pending")
  expiresAt DateTime

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([boardId])
  @@index([token])
}

model Epic {
  id          String   @id @default(cuid())
  title       String
  description String?
  color       String   @default("#3b82f6")
  quarter     String?  // e.g. "2026-Q1", "2026-Q2"
  status      String   @default("open") // "open" | "completed"
  order       Int      @default(0)

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}

model List {
  id    String @id @default(cuid())
  title String
  order Int

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?
  completed     Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("CompletedTasks", fields: [completedById], references: [id], onDelete: SetNull)
  priority      String?
  startDate   DateTime?
  dueDate     DateTime?

  // Archive & Quarter & Epics
  archived    Boolean   @default(false)
  archivedAt  DateTime?
  quarter     String?   // e.g. "2026-Q1", "2026-Q2"
  
  epicId      String?
  epic        Epic?     @relation(fields: [epicId], references: [id], onDelete: SetNull)

  // Public Share Link & Calendar Sync
  shareToken     String? @unique
  googleEventId  String?

  order Int

  listId String
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  qaId String?
  qa   User?   @relation("TaskQA", fields: [qaId], references: [id], onDelete: SetNull)

  labels        TaskLabel[]
  comments      Comment[]
  attachments   Attachment[]
  collaborators TaskCollaborator[]
  subtasks      Subtask[]
  customValues  CustomFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listId])
  @@index([epicId])
  @@index([shareToken])
  @@index([archived])
  @@index([assigneeId])
  @@index([qaId])
}

model TaskCollaborator {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([taskId])
}

model Comment {
  id      String @id @default(cuid())
  content String

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model Label {
  id      String @id @default(cuid())
  title   String
  color   String

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  tasks TaskLabel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model Subtask {
  id        String  @id @default(cuid())
  title     String
  completed Boolean @default(false)
  order     Int

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
}

model Attachment {
  id       String @id @default(cuid())
  filename String
  url      String
  size     Int

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
}

model ActivityLog {
  id      String @id @default(cuid())
  type    String
  message String

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([boardId, createdAt])
}

model CustomField {
  id         String   @id @default(cuid())
  boardId    String
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name       String
  type       String   // "NUMBER" | "TEXT" | "SELECT"
  options    Json?    // e.g. ["dev", "integration", "uat", "production"]
  enabled    Boolean  @default(true)
  isDefault  Boolean  @default(false)
  defaultKey String?  // "story_points" | "environment" | "parent" | "child" | "customer"
  order      Int      @default(0)

  values CustomFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
  @@unique([boardId, defaultKey])
}

model CustomFieldValue {
  id            String      @id @default(cuid())
  taskId        String
  task          Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  value         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskId, customFieldId])
  @@index([taskId])
  @@index([customFieldId])
}
