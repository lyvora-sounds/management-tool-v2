# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno. Copiar a `.env` y rellenar.
#
# Prisma solo lee `.env` (lo carga prisma.config.ts vía dotenv). No uses
# `.env.development`: Next no lo carga en builds de producción y da la falsa
# sensación de tener entornos separados.
#
# En Vercel cada variable se marca por entorno: Production / Preview /
# Development. Las NEXT_PUBLIC_* se incrustan en tiempo de BUILD, así que si
# no están marcadas para Preview, el build de preview sale sin ellas.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (Neon) ─────────────────────────────────────────────────────
# Cada entorno apunta a SU PROPIA branch de Neon. Nunca compartir la de
# producción con desarrollo.
#
# DATABASE_URL      -> cadena CON pooler (host con `-pooler`). La usa la app.
# DATABASE_URL_UNPOOLED -> cadena SIN pooler. La usa la CLI de Prisma para
#   migrar: a través del pooler el advisory lock de `migrate deploy` falla
#   con P1002.
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Clerk ────────────────────────────────────────────────────────────────────
# Producción: claves de la instancia de producción (pk_live_ / sk_live_).
# Preview y local: claves de la instancia de desarrollo (pk_test_ / sk_test_).
# No se pueden usar claves de producción en un dominio *.vercel.app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Del endpoint de webhook, y es distinto en cada instancia de Clerk.
CLERK_WEBHOOK_SECRET="whsec_..."

# Rutas relativas: iguales en los tres entornos. Si las pones absolutas,
# la preview rebota a producción al iniciar sesión.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# ── URL pública de la app ────────────────────────────────────────────────────
# Distinta en cada entorno. Se usa para construir enlaces de invitación, de
# compartir tarea y el callback de Google Calendar; si apunta al sitio
# equivocado, esos enlaces llevan a otro entorno.
#   Producción -> https://kikiboard.xyz
#   Preview    -> el dominio de la preview
#   Local      -> http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Cifrado de las claves de IA de los usuarios ──────────────────────────────
# ¡CUIDADO! Si esta variable no existe, lib/crypto.ts deriva la clave de
# CLERK_SECRET_KEY. Cambiar el valor deja ILEGIBLE todo lo ya cifrado.
# En producción: ponerla una vez y no rotarla a la ligera.
ENCRYPTION_SECRET="cadena-larga-y-aleatoria-propia-de-cada-entorno"

# ── Servicios externos ───────────────────────────────────────────────────────
# Resend se instancia a nivel de módulo, así que sin esta variable falla
# incluso el build.
RESEND_API_KEY="re_..."

# Vercel Blob, para los adjuntos. El store debe ser PRIVADO: se sube con
# access: "private" y se sirve por /api/tasks/.../attachments/.../download,
# que comprueba permisos antes de entregar el archivo.
#
# Vercel crea BLOB_READ_WRITE_TOKEN y BLOB_STORE_ID al conectar el store al
# proyecto; no se generan a mano. VERCEL_OIDC_TOKEN lo inyecta Vercel en cada
# deployment y no aparece en la lista de variables.
#
# En local basta con el token: sin OIDC el SDK cae a él.
# La ruta de descarga lo lee directamente de process.env, así que sin esta
# variable las descargas fallan aunque OIDC esté disponible.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Solo necesaria si quieres autenticar por OIDC (en Vercel la pone sola).
# BLOB_STORE_ID="store_..."

# ── Google Calendar (opcional) ───────────────────────────────────────────────
# Sin estas dos, la integración lanza al intentar conectarse.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Opcional: si se omite, se deriva de NEXT_PUBLIC_APP_URL + la ruta de
# callback. Cada URI que se use debe estar autorizada en Google Cloud.
# GOOGLE_REDIRECT_URI=""
